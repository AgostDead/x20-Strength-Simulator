local UpgradeTab = Window:Tab({ Title = "Upgrades" })
UpgradeTab:Section({ Title = "Auto-Buy Upgrades" })

local function interactWithObject(parent, objectName)
    local obj = parent:FindFirstChild(objectName)
    if obj then
        if obj:IsA("RemoteEvent") then
            obj:FireServer()
        elseif obj:IsA("BasePart") then
            local cd = obj:FindFirstChildOfClass("ClickDetector")
            if cd then fireclickdetector(cd) end
        end
    end
end

local function createUpgradeToggle(title, listOfObjects)
    local connection = nil
    local isActive = false
    UpgradeTab:Toggle({
        Title = title,
        Value = false,
        Callback = function(state)
            isActive = state
            if isActive then
                if connection then connection:Disconnect() end
                connection = RunService.Heartbeat:Connect(function()
                    task.wait(0.3)
                    if not isActive then return end
                    pcall(function()
                        local get = game:GetService("Workspace"):FindFirstChild("Get")
                        local panel = game:GetService("Workspace"):FindFirstChild("Panel")
                        for _, objName in pairs(listOfObjects) do
                            if get then interactWithObject(get, objName) end
                            if panel then interactWithObject(panel, objName) end
                        end
                    end)
                end)
            else
                if connection then connection:Disconnect() connection = nil end
            end
        end,
    })
end

