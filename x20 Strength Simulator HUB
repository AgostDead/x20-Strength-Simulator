local function createFarmToggle(tab, title, eventName)
    local connection = nil
    tab:Toggle({
        Title = title,
        Value = false,
        Callback = function(state)
            if state then
                connection = RunService.Heartbeat:Connect(function()
                    task.wait(farmSpeed)
