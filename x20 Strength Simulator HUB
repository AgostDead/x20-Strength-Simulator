local isSpammingBox5 = false
local box5Connection = nil
BoxTab:Toggle({
    Title = "Auto Box5 (MAX SPAM)",
    Value = false,
    Callback = function(state)
        isSpammingBox5 = state
        if isSpammingBox5 then
            if box5Connection then box5Connection:Disconnect() end
            box5Connection = RunService.Heartbeat:Connect(function()
                task.wait(box5Speed)
                if not isSpammingBox5 then return end
                pcall(function()
                    local boxs = game:GetService("Workspace"):FindFirstChild("Boxs")
                    local panel = game:GetService("Workspace"):FindFirstChild("Panel")
                    local function spamBox5(obj)
                        if obj then
                            if obj:IsA("RemoteEvent") then
                                for i = 1, 5 do obj:FireServer() end
                            elseif obj:IsA("BasePart") then
                                local cd = obj:FindFirstChildOfClass("ClickDetector")
                                if cd then for i = 1, 5 do fireclickdetector(cd) end end
                            end
                        end
                    end
                    if boxs then spamBox5(boxs:FindFirstChild("box5")) end
                    if panel then spamBox5(panel:FindFirstChild("box5")) end
                end)
            end)
        else
            if box5Connection then box5Connection:Disconnect() box5Connection = nil end
        end
