local PlayerTab = Window:Tab({ Title = "Player" })
PlayerTab:Section({ Title = "Physics & Movement" })

PlayerTab:Slider({
    Title = "WalkSpeed",
    Value = { Min = 16, Max = 500, Default = Config.WalkSpeed or 16 },
    Callback = function(value)
        Config.WalkSpeed = value
        saveConfig()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = value end
        end
    end
})

local noclip = false
local noclipConnection = nil
PlayerTab:Toggle({
    Title = "Noclip",
    Value = false,
    Callback = function(state)
        noclip = state
        if noclip then
            noclipConnection = RunService.Stepped:Connect(function()
                if noclip and LocalPlayer.Character then
                    for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end)
        else
            if noclipConnection then noclipConnection:Disconnect() end
        end
    end
})

local isFlying = false
local flyConnection = nil
local flySpeed = 50

PlayerTab:Slider({
    Title = "Fly Speed",
    Value = { Min = 10, Max = 200, Default = 50 },
    Callback = function(value) flySpeed = value end
})

PlayerTab:Toggle({
    Title = "Fly",
    Value = false,
    Callback = function(state)
        isFlying = state
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if isFlying and hrp and hum then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlyBV"
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
            
            flyConnection = RunService.RenderStepped:Connect(function()
                if not isFlying or not hrp or not hum then return end
                local camera = workspace.CurrentCamera
                local moveDir = hum.MoveDirection
                local upDown = 0
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then upDown = 1 end
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then upDown = -1 end
                bv.Velocity = (camera.CFrame.LookVector * moveDir.Z + camera.CFrame.RightVector * moveDir.X + Vector3.new(0, upDown, 0)) * flySpeed
            end)
        else
            if flyConnection then flyConnection:Disconnect() end
            if hrp then
                local bv = hrp:FindFirstChild("FlyBV")
                if bv then bv:Destroy() end
            end
        end
    end
})

local function onCharacterAdded(char)
    task.wait(1)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and Config.WalkSpeed then hum.WalkSpeed = Config.WalkSpeed end
end
if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

