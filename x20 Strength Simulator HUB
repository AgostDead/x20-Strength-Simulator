local MainTab = Window:Tab({ Title = "Main", Icon = "swords" })
MainTab:Section({ Title = "Farming & Upgrades" })

-- Farm / Sell
local farmSpeed = 0.05
MainTab:Slider({
    Title = "Farm Speed",
    Desc = "0.05 = Fast / 0.1 = Safe",
    Icon = "zap",
    Value = { Min = 0.01, Max = 0.5, Default = 0.05 },
    Step = 0.01,
    Callback = function(val) farmSpeed = val end
})

local isFarming = false
local farmConnection = nil

MainTab:Toggle({
    Title = "Auto Farm / Sell",
    Desc = "Spams Lift and Sell",
    Icon = "flame",
    Value = false,
    Callback = function(state)
        isFarming = state
        if isFarming then
            if farmConnection then farmConnection:Disconnect() end
            farmConnection = RunService.Heartbeat:Connect(function()
                task.wait(farmSpeed)
                if not isFarming then return end
                pcall(function()
                    ReplicatedStorage.Events.Lift:FireServer()
                    ReplicatedStorage.Events.Sell:FireServer()
                end)
            end)
            PainKillersUI:Notify({Title = "Auto Farm", Content = "Enabled", Duration = 3, Icon = "play"})
        else
            if farmConnection then farmConnection:Disconnect() farmConnection = nil end
            PainKillersUI:Notify({Title = "Auto Farm", Content = "Disabled", Duration = 3, Icon = "square"})
        end
    end,
})

