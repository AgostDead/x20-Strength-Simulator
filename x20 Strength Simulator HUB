local function pressPanelButton(name)
    pcall(function()
        local panel = game:GetService("Workspace"):FindFirstChild("Panel")
        local get = game:GetService("Workspace"):FindFirstChild("Get")
        local function click(parent, btnName)
            if parent then
                local btn = parent:FindFirstChild(btnName)
                if btn then
                    if btn:IsA("RemoteEvent") then btn:FireServer()
                    elseif btn:IsA("BasePart") then
                        local cd = btn:FindFirstChildOfClass("ClickDetector")
                        if cd then fireclickdetector(cd) end
                    end
                end
            end
        end
        click(panel, name)
        click(get, name)
    end)
end

