local function createBoxToggle(title, boxList, getSpeedFunc)
    local isActive = false
    local connection = nil
    BoxTab:Toggle({
        Title = title,
        Value = false,
        Callback = function(state)
            isActive = state
            if isActive then
                if connection then connection:Disconnect() end
                connection = RunService.Heartbeat:Connect(function()
                    task.wait(getSpeedFunc()) 
                    if not isActive then return end
                    pcall(function()
                        local getbox = game:GetService("Workspace"):FindFirstChild("Getbox")
                        if getbox then
                            for _, boxName in pairs(boxList) do
                                interactWithObject(getbox, boxName)
                            end
                        end
                    end)
                end)
            else
                if connection then connection:Disconnect() connection = nil end
            end
        end,
    })
end

